index 0000000..a456139
--- /dev/null
+++ b/src/components/features/chat/git-drift-banner.test.tsx
@@ -0,0 +1,44 @@
+import { cleanup, render, screen } from "@testing-library/react";
+import { createInstance } from "i18next";
+import { I18nextProvider } from "react-i18next";
+import { afterEach, expect, it, vi } from "vitest";
+import translations from "#/i18n/translation.json";
+import { GitDriftBanner } from "./git-drift-banner";
+
+// Exercise real interpolation instead of the shared key-returning test stub.
+vi.unmock("react-i18next");
+
+afterEach(cleanup);
+
+it("renders both supplied revisions through the actual translation resources", async () => {
+  const i18n = createInstance();
+  await i18n.init({
+    lng: "en",
+    defaultNS: "openhands",
+    interpolation: { escapeValue: false },
+    resources: {
+      en: {
+        openhands: Object.fromEntries(
+          Object.entries(translations).map(([key, value]) => [key, value.en]),
+        ),
+      },
+    },
+  });
+  const previousHead = "a1b2c3d4".repeat(5);
+  const currentHead = "e5f6a7b8".repeat(5);
+
+  render(
+    <I18nextProvider i18n={i18n}>
+      <GitDriftBanner
+        summary="External commit"
+        previousHead={previousHead}
+        currentHead={currentHead}
+        onRefreshBaseline={vi.fn()}
+        onDismiss={vi.fn()}
+      />
+    </I18nextProvider>,
+  );
+
+  expect(screen.getByText(new RegExp(previousHead.slice(0, 8)))).toBeTruthy();
+  expect(screen.getByText(new RegExp(currentHead.slice(0, 8)))).toBeTruthy();
+});
