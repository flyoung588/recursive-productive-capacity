# Local development, never commit a generated .env.
# scripts/local-setup.sh generates a random password on first use.
DEV_POSTGRES_PASSWORD=__LOCAL_PASSWORD__
POSTGRES_URL=postgresql://harmonica:__LOCAL_PASSWORD__@localhost:5432/harmonica
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Required separately for authenticated UI and supported cloud model use:
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
MAIN_LLM_PROVIDER=openai
MAIN_LLM_MODEL=gpt-4o-mini
SMALL_LLM_PROVIDER=openai
SMALL_LLM_MODEL=gpt-4o-mini
LARGE_LLM_PROVIDER=openai
LARGE_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
